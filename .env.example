# Skillo Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# Active Backend Provider ('firebase' or 'supabase' — defaults to 'firebase' when Firebase is configured)
NEXT_PUBLIC_BACKEND_PROVIDER=firebase

# Firebase Client Configuration (Firebase Console -> Project Settings -> General -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Server Admin SDK (Firebase Console -> Project Settings -> Service accounts -> Generate new private key)
# Required only for server routes (rate limiting, background tasks)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Supabase (Alternative provider)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic Configuration (server-only — no NEXT_PUBLIC_ prefix)
# Used by evaluation, follow-up (LATS), SimPO, and resume analysis
ANTHROPIC_API_KEY=your_anthropic_api_key
# Anthropic model identifier (optional, default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Code Execution Engine (optional)
# Piston-compatible API endpoint for running candidate code (e.g., https://emkc.org/api/v2/piston)
# If unset, POST /api/code/run returns HTTP 501 Not Implemented
CODE_RUNNER_URL=https://emkc.org/api/v2/piston

# Admin Access Control
# Comma-separated list of administrator email addresses gating access to /calibration
ADMIN_EMAILS=admin@example.com,lead@example.com

# Site Configuration
# Canonical base URL for auth redirects and origin checks (default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Application Credentials (optional alternative for Firebase Admin SDK)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# AI Provider (server-only, never prefix with NEXT_PUBLIC_)
# Choose which LLM provider powers evaluation, follow-ups, SimPO, Reflexion and resume analysis.
#   anthropic -> uses ANTHROPIC_API_KEY / ANTHROPIC_MODEL (above)
#   groq      -> uses GROQ_API_KEY / GROQ_MODEL (below)
# If AI_PROVIDER is unset, whichever key is present is used (Anthropic first).
AI_PROVIDER=anthropic
GROQ_API_KEY=your_groq_api_key
# Groq retires models over time. List the ones your key can use:
#   GET https://api.groq.com/openai/v1/models   (Authorization: Bearer <key>)
GROQ_MODEL=openai/gpt-oss-120b
# Optional tuning (Groq free tiers are rate limited per minute):
# AI_LATS_ROUNDS=1          # follow-up search rounds (default 1 on Groq, 3 on Anthropic)
# AI_MAX_CONCURRENCY=2      # simultaneous model calls per server instance (Groq only)
# GROQ_REASONING_EFFORT=low # for openai/gpt-oss models: low | medium | high
