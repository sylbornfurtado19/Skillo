{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/interview/layout,_N_T_/app/interview/page,_N_T_/app/interview"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/interview/__PAGE__",
    "/app/interview",
    "/app",
    "/_index",
    "/_head"
  ]
}