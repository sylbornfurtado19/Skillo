{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/results/layout,_N_T_/app/results/page,_N_T_/app/results"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/results/__PAGE__",
    "/app/results",
    "/app",
    "/_index",
    "/_head"
  ]
}