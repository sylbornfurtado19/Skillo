{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/resume/layout,_N_T_/app/resume/page,_N_T_/app/resume"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/resume/__PAGE__",
    "/app/resume",
    "/app",
    "/_index",
    "/_head"
  ]
}